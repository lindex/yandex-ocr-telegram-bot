# Обязательные
TG_TOKEN=
# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
YC_API_KEY=
YC_FOLDER_ID=

# Необязательные
TTS_VOICE=alena
# MTProto-прокси: tg://proxy?server=...&port=...&secret=...
TG_PROXY=
# ID админов через запятую (свой ID можно узнать у @userinfobot)
TG_ADMINS=
# private — только админы и те, кого они пустили через бота; public — все
ACCESS_MODE=private
# Где хранить сессию Telegram и список пользователей (в Docker уже /data)
DATA_DIR=data
