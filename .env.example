# Обязательные
TG_TOKEN=
# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
YC_API_KEY=
YC_FOLDER_ID=

# Необязательные
TTS_VOICE=alena
# MTProto-прокси: tg://proxy?server=...&port=...&secret=...
TG_PROXY=
# ID админов через запятую (узнать свой ID: написать боту — он ответит, или @userinfobot)
TG_ADMINS=
# private — только админы и TG_ALLOWED_USERS; public — все
ACCESS_MODE=private
TG_ALLOWED_USERS=
